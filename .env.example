# OBRIGATORIO: Chave da Groq (Gratuita - https://console.groq.com)
GROQ_API_KEY=gsk_...

# RECOMENDADO: Serper API para pesquisa de tendencias na web
# Gratis ate 2.500 buscas/mes em https://serper.dev
SERPER_API_KEY=...

# RECOMENDADO: Pexels API para imagens gratuitas de alta qualidade
# Gratis em https://www.pexels.com/api/
PEXELS_API_KEY=...

# OPCIONAL: Configuracao
LOG_LEVEL=INFO
MAX_RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=60
